# Copy this file to .env and fill in real values. Never commit .env.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# Gmail SMTP (use an App Password, not your normal password).
# Leave blank to run locally; emails are then printed to the terminal instead of sent.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Uploads (resumes, pictures, logos). Leave unset locally: files go to ./media.
# Production: copy the "API Environment variable" from your Cloudinary dashboard:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Production only (set these in the Render dashboard, not locally):
# RENDER=true
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Local development only. Leave unset (or False) in production.
DEBUG=True

# Optional: comma-separated hosts. Defaults to 127.0.0.1,localhost.
# ALLOWED_HOSTS=127.0.0.1,localhost
